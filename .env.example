NODE_ENV=development
CVG_HOST=127.0.0.1
CVG_TRUST_PROXY=false
CVG_API_PORT=4310
CVG_WEB_ORIGIN=http://127.0.0.1:5173
CVG_STORAGE=memory
CVG_DEMO_MODE=true
DATABASE_URL=postgresql://127.0.0.1:5440/cvg_m1_synthetic
MIGRATION_DATABASE_URL=postgresql://cvg_migration:replace-me@127.0.0.1:5440/cvg_local
CVG_RUNTIME_DB_USER=cvg_runtime
CVG_RUNTIME_DB_PASSWORD=replace-me-runtime-password
SESSION_TTL_MINUTES=480
CVG_SECRET_PROVIDER=none
CVG_SECRET_DIR=/run/secrets/cvg
CVG_RATE_LIMIT_BACKEND=local
CVG_RATE_LIMIT_REQUESTS_PER_WINDOW=120
CVG_RATE_LIMIT_WINDOW_SECONDS=60
CVG_WORKER_ORGANIZATION_ID=
CVG_WORKER_ID=cvg-worker-local
CVG_WORKER_INTERVAL_MS=5000
CVG_WORKER_SINK_MODE=quarantine
CVG_WORKER_HEARTBEAT_FILE=/tmp/cvg-worker/heartbeat
CVG_MESSAGING_PROVIDER_ENDPOINT=
CVG_MESSAGING_PROVIDER_ALLOWED_HOSTS=
CVG_MESSAGING_CREDENTIAL_REF=
CVG_MESSAGING_SEND_PATH=/messages
CVG_MESSAGING_QUERY_PATH=/messages/:providerRequestId
CVG_DEEPSEEK_RUNTIME_ENABLED=false
# Only set the following together in an explicitly approved environment.
# CVG_DEEPSEEK_BASE_URL=https://harness.example.internal
# CVG_DEEPSEEK_EXPECTED_ENGINE_COMMIT=0000000000000000000000000000000000000000
# CVG_DEEPSEEK_EXPECTED_MANIFEST_VERSION=approved-profile-1
# CVG_DEEPSEEK_BEARER_TOKEN_REF=deepseek.gateway.token
