# syntax=docker/dockerfile:1.10@sha256:865e5dd094beca432e8c0a1d5e1c465db5f998dca4e439981029b3b81fb39ed5

# The manifest-list digest was observed from the registry on 2026-09-23. It
# pins the Node 24.21.0 build toolchain input without claiming a signature.
FROM node:24.21.0-trixie-slim@sha256:8ec5d7557396cfe32d21c3f9c13072355ceab22b584578ca4bb28af31120cffe AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
COPY db ./db
COPY scripts ./scripts
COPY docker ./docker

RUN npm ci --include=dev --ignore-scripts --no-audit --fund=false
RUN npm run typecheck
RUN npm run build:runtime
RUN node --check docker/runtime-entrypoint.mjs

# The final image contains only the Node runtime, compiled bundles, and
# migration SQL required by the migrate command. npm, tsx, TypeScript source,
# tests, and build dependencies never cross this stage boundary.
# Digest refreshed on 2026-10-08: the previous base shipped libssl3t64
# 3.5.7-1~deb13u2 (CVE-2026-75804, CVE-2026-84782, HIGH, fixed in deb13u3);
# Node stays v24.21.0.
FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:9eeb7f5887d0e239e78264b06f7f11d2e14be534050481803a9e4728fcdd278e AS runtime

ARG CVG_SOURCE_REVISION=unbound
LABEL org.opencontainers.image.revision=$CVG_SOURCE_REVISION \
      org.opencontainers.image.base.name="gcr.io/distroless/nodejs24-debian13:nonroot" \
      org.opencontainers.image.base.digest="sha256:9eeb7f5887d0e239e78264b06f7f11d2e14be534050481803a9e4728fcdd278e"

WORKDIR /app/runtime

COPY --from=build --chown=65532:65532 /app/dist/runtime/ /app/runtime/
COPY --from=build --chown=65532:65532 /app/docker/runtime-entrypoint.mjs /app/runtime/entrypoint.mjs
COPY --from=build --chown=65532:65532 /app/docker/init-backup-volume.mjs /app/runtime/init-backup-volume.mjs

ENV NODE_ENV=production \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false

USER 65532:65532

EXPOSE 4310

HEALTHCHECK --interval=10s --timeout=4s --start-period=30s --retries=6 \
  CMD ["/nodejs/bin/node", "--input-type=module", "-e", "fetch('http://127.0.0.1:4310/api/v1/ready').then(async (response) => { const body = await response.json(); if (!response.ok || body?.data?.ready !== true) process.exit(1); }).catch(() => process.exit(1))"]

ENTRYPOINT ["/nodejs/bin/node", "/app/runtime/entrypoint.mjs"]
CMD ["api"]
