# syntax=docker/dockerfile:1.10@sha256:865e5dd094beca432e8c0a1d5e1c465db5f998dca4e439981029b3b81fb39ed5

FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
COPY db ./db
COPY scripts ./scripts
COPY docker ./docker

RUN npm ci --include=dev --ignore-scripts --no-audit --fund=false
RUN npm run build

# Registry manifest-list digest observed on 2026-09-21; no signature is
# inferred from this digest pin.
FROM nginxinc/nginx-unprivileged:1.31.5-alpine3.24@sha256:2ddec616f1cb58bcac057aa388f28cb81e35137641ef4226d321714499329bd1

ARG CVG_SOURCE_REVISION=unbound
LABEL org.opencontainers.image.revision=$CVG_SOURCE_REVISION \
      org.opencontainers.image.base.name="nginxinc/nginx-unprivileged:1.31.5-alpine3.24" \
      org.opencontainers.image.base.digest="sha256:2ddec616f1cb58bcac057aa388f28cb81e35137641ef4226d321714499329bd1"

# CVE-2026-93990: base alpine 3.24.1 ships libexpat 2.8.4-r0; the fix is in
# 2.8.5-r0 on the same branch. Upgrade only that package until the pinned base
# image digest is refreshed past it.
USER root
RUN apk upgrade --no-cache libexpat
USER 101

COPY docker/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=101:101 /app/dist/web /usr/share/nginx/html

USER 101

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 \
  CMD wget -q -O - http://127.0.0.1:8080/healthz | grep -qx ok
