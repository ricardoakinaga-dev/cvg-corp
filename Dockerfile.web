# syntax=docker/dockerfile:1

FROM node:24.20.0-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
COPY db ./db
COPY scripts ./scripts
COPY docker ./docker

RUN npm ci --include=dev --ignore-scripts
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.31.5-alpine3.24@sha256:19c132c9ab02d3b783f478743dafc7a7f42e27aa7d2bdcbec1bb1128ca8f2a07

ARG CVG_SOURCE_REVISION=unbound
LABEL org.opencontainers.image.revision=$CVG_SOURCE_REVISION

COPY docker/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/web /usr/share/nginx/html

USER 101

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 \
  CMD wget -q -O - http://127.0.0.1:8080/healthz | grep -qx ok
