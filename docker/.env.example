# Synthetic local fixture only. Keep real values outside the repository.
# The database password in DATABASE_URL must be URL-encoded and match below.
POSTGRES_PASSWORD=replace-me-local-only-123
MIGRATION_DATABASE_URL=postgresql://cvg_migration:replace-me-local-only-123@postgres:5432/cvg_local
DATABASE_URL=postgresql://cvg_runtime:replace-me-runtime-only-123@postgres:5432/cvg_local
CVG_RUNTIME_DB_USER=cvg_runtime
CVG_RUNTIME_DB_PASSWORD=replace-me-runtime-only-123
CVG_BOOTSTRAP_PASSWORD=replace-me-local-only-bootstrap-123
CVG_WORKER_ORGANIZATION_ID=00000000-0000-4000-8000-000000000010

NODE_ENV=development
CVG_TRUST_PROXY=false
CVG_WEB_ORIGIN=http://localhost:8080
CVG_DEMO_MODE=true
CVG_SECRET_PROVIDER=none
CVG_RATE_LIMIT_BACKEND=local
CVG_RATE_LIMIT_REQUESTS_PER_WINDOW=120
CVG_RATE_LIMIT_WINDOW_SECONDS=60
CVG_DEEPSEEK_RUNTIME_ENABLED=false
CVG_AUTH_MFA_MODE=disabled
CVG_PASSWORD_MIN_LENGTH=12
CVG_PASSWORD_MAX_AGE_DAYS=90
CVG_AUTH_MAX_FAILED_ATTEMPTS=8
CVG_AUTH_LOCKOUT_MINUTES=15
CVG_AUTH_CHALLENGE_TTL_SECONDS=300
CVG_AUTH_MAX_CHALLENGE_ATTEMPTS=5

CVG_PROXY_BIND=127.0.0.1
CVG_PROXY_PORT=8080
CVG_POSTGRES_PORT=5440
CVG_WORKER_ID=cvg-worker-local
CVG_WORKER_SINK_MODE=quarantine
CVG_MESSAGING_PROVIDER_ENDPOINT=
CVG_MESSAGING_PROVIDER_ALLOWED_HOSTS=
CVG_MESSAGING_CREDENTIAL_REF=
CVG_MESSAGING_SEND_PATH=/messages
CVG_MESSAGING_QUERY_PATH=/messages/:providerRequestId
