{
  "name": "cvg-corp",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "CVG-Corp — sistema operacional veterinário local-first com governança de IA.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start": "npm run dev:api",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "worker": "npm run dev:worker",
    "build:runtime": "node docker/build-runtime.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "verify:coverage": "tsx scripts/verify-coverage.ts",
    "verify:mutation": "tsx scripts/verify-mutation.ts",
    "verify:aud26-evidence": "tsx scripts/verify-aud26-evidence.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=chromium-wide-1440 --project=chromium-tablet-768 --project=chromium-mobile-375 --project=firefox-wide-1440 --project=firefox-tablet-768 --project=firefox-mobile-375 --project=chromium-stress",
    "test:e2e:full": "playwright test",
    "test:e2e:smoke:serial": "playwright test --workers=1 --project=chromium-wide-1440 --project=chromium-tablet-768 --project=chromium-mobile-375 --project=chromium-stress --project=firefox-wide-1440 --project=firefox-tablet-768 --project=firefox-mobile-375",
    "test:contract": "node --import tsx --test tests/unit/contracts.test.ts",
    "test:database": "node --import tsx --test tests/integration/persistence.test.ts tests/integration/worker-jobs.test.ts tests/integration/restore.test.ts",
    "test:security": "node --import tsx --test tests/unit/auth.test.ts tests/unit/vnext.test.ts tests/integration/faults.test.ts",
    "test:fault": "node --import tsx --test tests/unit/worker.test.ts tests/integration/faults.test.ts",
    "test:restore": "node --import tsx --test tests/integration/restore.test.ts",
    "benchmark:local": "tsx scripts/benchmark-local.ts",
    "verify:load": "tsx scripts/verify-load.ts",
    "lint": "npm run lint:custom && npm run lint:oxlint",
    "lint:custom": "tsx scripts/lint.ts",
    "lint:oxlint": "oxlint . --deny-warnings",
    "verify:static": "tsx scripts/verify-static.ts",
    "verify:production": "tsx scripts/verify-production.ts --structural",
    "verify:alertmanager": "tsx scripts/render-alertmanager.ts --check",
    "release:provenance": "tsx scripts/verify-release-provenance.ts",
    "verify:release-provenance": "tsx scripts/verify-release-provenance.ts",
    "verify:promotion-invariant": "tsx scripts/verify-promotion-invariant.ts",
    "verify:container-smoke": "tsx scripts/verify-container-smoke.ts",
    "verify:security-red-team": "tsx scripts/verify-security-red-team.ts",
    "verify:resource-pressure": "tsx scripts/verify-resource-pressure.ts",
    "verify:runbook-execution": "tsx scripts/verify-runbook-execution.ts",
    "verify:evidence-snapshot": "tsx scripts/verify-evidence-snapshot.ts",
    "verify:pdp": "tsx scripts/verify-pdp-coverage.ts && npm run verify:pdp:runtime",
    "verify:pdp-universal": "tsx scripts/verify-pdp-universal.ts",
    "verify:m1": "npm run typecheck && npm test && npm run build && npm run verify:pdp && npm run verify:static && npm run verify:diff",
    "verify:all": "npm run verify:m1 && npm run test:e2e",
    "verify:postgres": "tsx scripts/verify-postgres.ts",
    "verify:postgres:concurrency": "tsx scripts/verify-postgres-concurrency.ts",
    "verify:postgres:schema-gates": "tsx scripts/verify-postgres-schema-gates.ts",
    "verify:postgres:isolation": "tsx scripts/verify-postgres-request-isolation.ts",
    "verify:postgres:worker-effects": "tsx scripts/verify-postgres-worker-effects.ts",
    "verify:postgres:worker-crash-restart": "tsx scripts/verify-postgres-worker-crash-restart.ts",
    "verify:postgres:restore": "tsx scripts/verify-postgres-restore.ts",
    "verify:ephemeral-postgres": "tsx scripts/verify-ephemeral-postgres.ts",
    "verify:aud27-postgres-migration": "tsx scripts/verify-aud27-postgres-migration.ts",
    "verify:aud27-products-backfill": "tsx scripts/verify-aud27-products-backfill.ts",
    "verify:aud27-normalized-writes": "tsx scripts/verify-aud27-normalized-writes.ts",
    "verify:aud27-24-slices": "tsx scripts/verify-aud27-24-slices.ts",
    "verify:backup-retention": "tsx scripts/verify-backup-retention.ts",
    "verify:audit-chain": "tsx scripts/verify-audit-chain.ts",
    "verify:authoritative-writes": "tsx scripts/verify-authoritative-writes.ts",
    "verify:deepseek-acp": "tsx scripts/verify-deepseek-acp.ts",
    "verify:deepseek-real": "tsx scripts/verify-deepseek-real.ts",
    "verify:provider-sandbox": "tsx scripts/verify-provider-sandbox.ts",
    "verify:secrets": "node scripts/verify-secrets.mjs",
    "verify:provider-real": "tsx scripts/verify-provider-real.ts",
    "verify:observability-local": "tsx scripts/ops/verify-observability-local.ts",
    "verify:load-local": "tsx scripts/load/run-local-load.ts",
    "verify:chaos-local": "tsx scripts/chaos/run-local-chaos.ts",
    "verify:dr-local": "tsx scripts/dr/run-local-dr.ts",
    "verify:worker-runtime": "tsx scripts/verify-worker-runtime.ts",
    "verify:architecture": "tsx scripts/verify-architecture.ts",
    "verify:agent-runtime": "tsx scripts/verify-agent-runtime.ts",
    "verify:agent-runtime-smoke": "tsx scripts/verify-agent-runtime-smoke.ts",
    "verify:agent-chaos": "tsx scripts/verify-agent-chaos.ts",
    "benchmark:agent-runtime": "tsx scripts/benchmark-agent-runtime.ts",
    "verify:embedded-harness": "tsx scripts/verify-embedded-harness.ts",
    "verify:agent-security": "tsx scripts/verify-agent-security.ts",
    "verify:plugins": "tsx scripts/verify-plugins.ts",
    "verify:skills": "tsx scripts/verify-skills.ts",
    "verify:agent-evals": "tsx scripts/verify-agent-evals.ts",
    "verify:ai-disabled": "tsx scripts/verify-ai-disabled.ts",
    "verify:embedded-deepseek": "tsx scripts/verify-embedded-deepseek.ts",
    "verify:model-real": "tsx scripts/verify-embedded-deepseek.ts",
    "verify:state-of-art": "tsx scripts/verify-state-of-art.ts",
    "verify:state-of-art-external": "tsx scripts/verify-state-of-art-external.ts",
    "verify:docs-provenance": "tsx scripts/verify-docs-provenance.ts",
    "verify:claims": "tsx scripts/verify-claims.ts",
    "verify:triplo-aaa": "tsx scripts/verify-triplo-aaa.ts",
    "verify:staging": "tsx scripts/verify-staging.ts",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:check": "tsx scripts/db.ts check",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "audit:licenses": "tsx scripts/verify-licenses.ts",
    "audit:tokens": "tsx scripts/audit-design-tokens.ts apps/web/src --strict",
    "audit:contrast": "tsx scripts/check-contrast.ts",
    "verify:pdp:runtime": "node --import tsx --test tests/integration/route-catalog.test.ts",
    "verify:diff": "git diff --check",
    "verify:control-plane": "tsx scripts/verify-control-plane.ts",
    "verify:aud27-semantics": "tsx scripts/verify-aud27-semantics.ts",
    "verify:schema-manifest": "tsx scripts/verify-schema-manifest.ts",
    "verify:snapshot-command-migration": "tsx scripts/verify-snapshot-command-migration.ts",
    "verify:aud27-migration-harness": "node --import tsx --test tests/unit/aud27-migration-harness.test.ts",
    "verify:aud27-evidence-root": "tsx scripts/verify-aud27-evidence-root.ts",
    "verify:aud27-evidence-completeness": "tsx scripts/verify-aud27-evidence-completeness.ts",
    "verify:docs-integrity": "tsx scripts/docs-integrity.ts",
    "verify:mel23-evidence": "tsx scripts/verify-mel23-evidence.ts",
    "verify:mel23-control-plane": "tsx scripts/capture-mel23-control-plane.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "fastify": "^5.5.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "0.28.2",
    "oxlint": "1.85.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  }
}
